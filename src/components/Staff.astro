---
import staff from "../config/staff"
---
<section class="w-full px-3 md:w-3/4 h-fit m-auto text-center">
    <h2 class="uppercase text-3xl mt-32 mb-5 md:mb-12 font-bold text-white">Nuestro Equipo</h2>
    <div class="flex flex-wrap items-center justify-center md:gap-10">
        {staff.map(staff => (
            <article class="flex items-center w-1/2 md:w-fit justify-center flex-col">
                <div class="md:w-48 md:h-48 xl:w-64 xl:h-64 w-36 h-36 rounded-full bg-cover bg-center border-4 md:border-8 border-white" style={{ backgroundImage: `url(${staff.img})` }} />
                <h2 class="text-white xl:text-2xl font-semibold mt-3">{staff.title}</h2>
                <span class="text-white xl:text-xl">{staff.desc}</span>
            </article>
        ))}
    </div>
</section>