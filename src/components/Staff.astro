---
import staff from "../config/staff"
---
<section class="w-3/4 h-fit m-auto text-center">
    <h2 class="uppercase text-3xl mb-10 font-bold text-white">Nuestro Equipo</h2>
    <div class="flex items-center justify-center gap-20">
        {staff.map(staff => (
            <article class="flex flex-wrap items-center justify-center flex-col">
                <img class="w-64 h-64 rounded-full border-8 border-white" src={staff.img} alt="" />
                <h2 class="text-white text-2xl font-semibold mt-3">{staff.title}</h2>
                <span class="text-white text-xl">{staff.desc}</span>
            </article>
        ))}
    </div>
</section>