---
import ButtonC from "./ButtonC.astro";
---

<header id="header" class="w-full fixed opacity-0 top-0 h-fit z-50 flex  transition" style="background-color: #262626">
    <div class="w-3/4 flex items-center justify-center md:justify-between m-auto">
        <img src="/assets/logo.png" class="w-32" alt="">
        <nav class="hidden md:flex gap-5 items-center">
            <span class="font-bold text-white">SOLUCIONES TECNOLÓGICAS</span>
            <a href="#footer" class="font-bold bg-blue-600 text-white px-5 py-2">CONTACTOS</a>
        </nav>
    </div>
</header>

<script>
    window.addEventListener("scroll", () => {
        const header = document.getElementById("header")
        if (header) {
            if (window.scrollY < 400) {
                header.classList.add("opacity-0")
                header.classList.remove("opacity-100");
            } else {
                header.classList.remove("opacity-0");
                header.classList.add("opacity-100");
            }
        }
    })
</script>