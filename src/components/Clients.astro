---
import { clients } from "../config/clients";
---

<section class="w-full md:w-fit m-auto my-15 px-2">
    <div class="flex items-center flex-wrap md:gap-12 gap-5 justify-center">
        {
            clients.map((src) => (
                <img src={src} alt="cliente" class="w-32 md:w-42" />
            ))
        }
    </div>
</section>
