---
import { clients } from "../config/clients";
---

<section class="w-3/4 m-auto py-6">
    <h2 class="text-center text-white text-3xl font-bold">
        ELLOS CONFIAN EN NOSOTROS
    </h2>
    <div class="relative overflow-hidden">
        <!-- Track: contiene dos veces la lista para crear el efecto infinito -->
        <div class="scroll-track flex items-center gap-8 whitespace-nowrap">
            <div class="icons flex items-center gap-8">
                {
                    clients.map((src) => (
                        <div class="logo flex-shrink-0 w-60 h-42 items-center inline-flex justify-center">
                            <img
                                src={src}
                                alt="cliente"
                                class="max-h-full max-w-full object-contain"
                            />
                        </div>
                    ))
                }
            </div>
            <div class="icons flex items-center gap-8">
                {
                    clients.map((src) => (
                        <div class="logo flex-shrink-0 w-60 h-42 flex items-center justify-center">
                            <img
                                src={src}
                                alt="cliente"
                                class="max-h-full max-w-full object-contain"
                            />
                        </div>
                    ))
                }
            </div>
            <div class="icons flex items-center gap-8">
                {
                    clients.map((src) => (
                        <div class="logo flex-shrink-0 w-60 h-42 flex items-center justify-center">
                            <img
                                src={src}
                                alt="cliente"
                                class="max-h-full max-w-full object-contain"
                            />
                        </div>
                    ))
                }
            </div>

        </div>
        <div
            class="pointer-events-none absolute left-0 top-0 bottom-0 w-24"
            style="background: linear-gradient(to right, transparent-to-color); mix-blend-mode:normal;"
        >
        </div>
        <div
            id="staff"
            class="pointer-events-none absolute right-0 top-0 bottom-0 w-24"
            style="background: linear-gradient(to left, transparent-to-color); mix-blend-mode:normal;"
        >
        </div>
    </div>

    <style>
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .scroll-track {
    display: flex;
    align-items: center;
    gap: 2rem;
    animation: marquee var(--marquee-duration, 30s) linear infinite;
  }

</style>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    const track = document.querySelector<HTMLElement>('.scroll-track');
    if (!track) return;
    const trackWidth = track.scrollWidth / 2; // Una copia del set de logos
    console.log(track.scrollWidth);
    
    const speed = window.innerWidth <= 768 ? 300 : 720; // px por segundo
    const duration = trackWidth / speed;
    track.style.setProperty('--marquee-duration', `${duration}s`);
  });
</script>
</section>
